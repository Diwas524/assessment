rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // One document per phone number, e.g. assessments/+15551234567
    // Only the person who verified that exact phone number via OTP
    // (Firebase Phone Auth) can read or write their own document.
    match /assessments/{phoneId} {
      allow read, write: if request.auth != null
                          && request.auth.token.phone_number == phoneId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
